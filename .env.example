# Orbit Console Environment Configuration
# Copy to .env and fill in secrets

# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-change-in-production-32-chars-minimum

# Database
DATABASE_URL=sqlite+aiosqlite:///./orbit.db
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/orbit

# OIDC / Keycloak
OIDC_ISSUER_URL=http://localhost:8080/realms/orbit
OIDC_CLIENT_ID=orbit-console
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/callback
OIDC_SCOPES=openid profile email roles

# Keycloak Admin
KEYCLOAK_ADMIN_PASSWORD=admin

# LLM (optional)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Frontend
FRONTEND_URL=http://localhost:3000

# Telemetry
METRICS_ENABLED=true
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=orbit-console